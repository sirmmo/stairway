# Required: a long random secret. Generate one with:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
STAIRWAY_TOKEN=change-me

# Public HTTPS URL of this server (used in links and OAuth metadata)
STAIRWAY_PUBLIC_URL=https://stairway.example.org

# Where new experiments go, and where existing folders may be attached from
STAIRWAY_EXPERIMENTS_ROOT=/srv/stairway/experiments
STAIRWAY_ALLOW=/srv

# Listen address; keep it private and put HTTPS in front
STAIRWAY_HOST=127.0.0.1
STAIRWAY_PORT=8765

# Optional: browser VS Code
#STAIRWAY_CODE_SERVER=/usr/bin/code-server

# Optional: opencode / crush agents through an OpenAI-compatible provider (OpenRouter by default)
#STAIRWAY_PROVIDER_API_KEY=sk-or-...
#STAIRWAY_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#STAIRWAY_PROVIDER_MODEL=deepseek/deepseek-v4.1-flash

# Optional: Telegram bot from @BotFather
#STAIRWAY_TELEGRAM_TOKEN=123456:ABC...
#STAIRWAY_TELEGRAM_PERMISSION_MODE=acceptEdits
